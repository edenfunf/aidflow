# ── AidFlow 環境設定範本 ──────────────────────────────────────────────
# 複製成 .env 後填寫。不要把實際密碼或金鑰提交進版控。

# 本機 Postgres 密碼：必填，docker-compose 會同時注入 db 與 api 兩個服務。
POSTGRES_PASSWORD=

# 只有「不透過 docker-compose」直接跑 API 時才需要自行填 DATABASE_URL：
# DATABASE_URL=postgresql+psycopg://resqlink:<POSTGRES_PASSWORD>@localhost:5432/resqlink

APP_NAME=AidFlow API
APP_VERSION=1.0.0
ENVIRONMENT=development

# ── 登入與權限（政府管理後台） ─────────────────────────────────────────
# true＝後台端點一律需要登入。正式環境必須為 true；false 僅供本機開發（所有權限開放）。
AUTH_REQUIRED=true
# 登入權杖簽章密鑰：32 字元以上的隨機字串（例：openssl rand -hex 32）。
# ENVIRONMENT 非 development 時未設定會拒絕啟動。
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
# true＝管理者建立或重設的密碼，使用者首次登入必須先變更（預設關閉，可自行到帳號設定變更）。
AUTH_FORCE_PASSWORD_CHANGE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# 首次啟動且沒有任何帳號時，以此建立系統管理者（首次登入須變更密碼）。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# 通報者稱呼／電話／Email 加密保存的金鑰（例：openssl rand -hex 32）。
# ENVIRONMENT 非 development 時未設定會拒絕啟動；設定後請妥善備份且不要更換，
# 遺失或更換將無法解密既有的聯絡資料。
DATA_ENCRYPTION_KEY=
# 允許呼叫 API 的前端網域（逗號分隔）。正式環境請列出實際網域，不可用 *。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 位於反向代理後方時才設為 true（由代理填入 X-Forwarded-For）；
# 直接對外時維持 false，否則用戶端可偽造位址繞過頻率限制。
TRUST_FORWARDED_FOR=false


# ── 濫用防護：公開端寫入 API 每 IP 每分鐘上限 ─────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REPORTS_PER_MINUTE=10
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
# 位於反向代理後方時信任 X-Forwarded-For
TRUST_FORWARDED_FOR=true

# Demo 模式：啟用示範資料帶入與示範平台清理。正式環境請設 false。
DEMO_MODE=false

# 對外網址（通知信與 LINE 訊息的連結會用到）
WEB_PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8000

# 雜湊回報者身分（裝置識別／聯絡方式）用的 salt，每個部署請更換。
# 通報者去識別化雜湊鹽：隨機字串，ENVIRONMENT 非 development 時未設定會拒絕啟動。
REPORTER_HASH_SALT=

# 預設成案規則（每個平台可在後台覆寫）
CLUSTER_REQUIRED_UNIQUE_REPORTERS=2
CLUSTER_RADIUS_METERS=100
CLUSTER_TIME_WINDOW_MINUTES=60

# 照片儲存目錄（容器內路徑；compose 會掛載 volume）
MEDIA_ROOT=/app/media

# ── LINE BOT：新通報推播至縣府 LINE 群組 ──────────────────────────────
# LINE Developers → Messaging API channel。未設定 token 時通知只記錄為「模擬」。
LINE_CHANNEL_ACCESS_TOKEN=
# 驗證 webhook 簽章（群組綁定）。Webhook URL 設為 {API_PUBLIC_BASE_URL}/v1/line/webhook
LINE_CHANNEL_SECRET=

# ── Email：通報民眾的案件進度通知 ─────────────────────────────────────
# 未設定 SMTP_HOST 時只記錄為「模擬」，不會寄出。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=AidFlow 災情通報 <no-reply@example.gov.tw>

# ── EMIC（消防署緊急應變管理資訊雲端服務系統）──────────────────────────
# 介接規格尚未提供：留空＝人工登錄模式（承辦於 EMIC 建案後回填案號與狀態）。
# 取得規格後設定上報端點，系統會以 app/domain/emic.py 的欄位對照送出 JSON。
EMIC_SUBMIT_URL=
EMIC_API_TOKEN=

# ── 官方開放資料介接 ───────────────────────────────────────────────────
# 中央氣象署 氣象資料開放平台授權碼（免費申請：https://opendata.cwa.gov.tw/）
# 供 雨量、天氣特報、雷達回波。留空＝相關圖層顯示「尚未設定金鑰」。
CWA_API_KEY=

# NCDR 民生示警公開資料平台 CAP feed URL（需平台會員授權）。留空＝不可用。
NCDR_CAP_FEED_URL=

# 交通部 TDX 會員中心申請：路況 CCTV 與路況消息
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 以下為公開資料，無需金鑰（可覆寫預設值，見 apps/api/app/core/config.py）：
# WRA_API_BASE=https://opendata.wra.gov.tw/api/v2
# NANTOU_CKAN_BASE=https://data.nantou.gov.tw/api/3/action
# ARDSWC_ALERT_URL=https://ls.ardswc.gov.tw/api/LandSlideAlertOpenData
# OFFICIAL_FILE_CACHE_DAYS=7

# 官方圖層快取秒數 / 上游逾時秒數
OFFICIAL_DATA_CACHE_SECONDS=300
OFFICIAL_DATA_TIMEOUT_SECONDS=12

# ── 前端（建置時讀取） ─────────────────────────────────────────────────
# 允許以 iframe 嵌入 /embed/{slug} 地圖的網站（空白或逗號分隔），例：
# EMBED_ALLOWED_ORIGINS=https://www.nantou.gov.tw https://*.nantou.gov.tw
EMBED_ALLOWED_ORIGINS=
