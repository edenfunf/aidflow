# ── AidFlow 環境設定範本 ──────────────────────────────────────────────
# 複製成 .env 後填寫。不要把實際密碼或金鑰提交進版控。

# 本機 Postgres 密碼：必填，docker-compose 會同時注入 db 與 api 兩個服務。
POSTGRES_PASSWORD=

# 只有「不透過 docker-compose」直接跑 API 時才需要自行填 DATABASE_URL：
# DATABASE_URL=postgresql+psycopg://resqlink:<POSTGRES_PASSWORD>@localhost:5432/resqlink

# 選用：設定後，/v1/public 與 /v1/health 以外的端點（規劃器、平台管理、案件派工、
# 內部通報）都需帶 X-API-Key 標頭。留空＝開放 demo 模式。
ADMIN_API_KEY=

APP_NAME=AidFlow API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Demo 模式：啟用 /v1/demo/nantou（南投豪雨示範情境）。正式環境請設 false。
DEMO_MODE=true

# 對外公開網站基底（通知訊息與後台連結會用到）
WEB_PUBLIC_BASE_URL=http://localhost:3000

# 雜湊回報者身分（裝置識別／聯絡方式）用的 salt，每個部署請更換。
REPORTER_HASH_SALT=change-me

# 預設成案規則（每個平台可在規劃時或後台覆寫）
CLUSTER_REQUIRED_UNIQUE_REPORTERS=2
CLUSTER_RADIUS_METERS=100
CLUSTER_TIME_WINDOW_MINUTES=60

# 照片儲存目錄（容器內路徑；compose 會掛載 volume）
MEDIA_ROOT=/app/media

# ── AI 情境解析（選用）。只用於規劃器理解災害描述；留空自動改用關鍵字規則，
#    平台生成本身是確定性的，不依賴模型。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 官方開放資料介接 ───────────────────────────────────────────────────
# 中央氣象署 氣象資料開放平台授權碼（免費申請：https://opendata.cwa.gov.tw/）
# 供 雨量站 O-A0002-001、天氣特報 W-C0033-001、地震報告 E-A0015-001。
# 留空＝雨量／官方警戒圖層顯示「尚未設定金鑰」，平台其餘功能不受影響。
CWA_API_KEY=

# NCDR 民生示警公開資料平台 CAP feed URL（需平台會員授權）。留空＝不可用。
NCDR_CAP_FEED_URL=

# 以下為公開資料，無需金鑰（可覆寫預設值）：
# 經濟部水利署 水利資料開放平台（河川水位測站站況 + 即時水位）
# WRA_API_BASE=https://opendata.wra.gov.tw/api/v2
# 南投縣政府資料開放平台 CKAN（消防局各單位地圖）
# NANTOU_CKAN_BASE=https://data.nantou.gov.tw/api/3/action
# 內政部消防署 避難收容處所點位檔（data.gov.tw 73242）
# MOI_SHELTER_CSV_URL=（見 apps/api/app/core/config.py）

# 官方圖層快取秒數 / 上游逾時秒數
OFFICIAL_DATA_CACHE_SECONDS=300
OFFICIAL_DATA_TIMEOUT_SECONDS=12

# ── LINE 官方帳號推播（module: line_notify，選用）。留空＝記錄為模擬通知。
LINE_CHANNEL_ACCESS_TOKEN=

# ── 派遣／出勤 ───────────────────────────────────────────────────────────
# 道路路徑規劃（OSRM）。預設公開 demo server 僅供輕量使用，正式環境請自架；留空＝直線估算。
OSRM_BASE_URL=https://router.project-osrm.org
# 出勤通報 webhook：縣府 EOC／CAD 系統接收 JSON（案號、類別、位置、回報摘要、照片連結）。
# 留空＝改走該單位的 LINE（需 LINE_CHANNEL_ACCESS_TOKEN 與單位 line_to）或記錄為模擬。
DISPATCH_WEBHOOK_URL=
# 出勤模擬參數（只在沒有 AVL 即時車位時使用，地圖會標示「模擬」）
DISPATCH_PREP_MINUTES=2
VEHICLE_SIM_SPEED_KMH=45
# 示範平台：案件仍在「已派員／前往中」時，模擬車輛循環重播路程（標示「示範重播」）；正式平台不受影響
VEHICLE_SIM_LOOP_DEMO=true
# AVL 即時車位（POST /v1/avl/positions）視為有效的秒數
AVL_STALE_SECONDS=180

# ── 第二波官方情資（全部走 env，未設定即顯示「未設定金鑰」，不會造假） ──
# 中央氣象署同一把授權碼也用於雷達整合回波透明圖層（O-A0058-005）
# 交通部 TDX 會員中心申請：路況 CCTV 與路況消息
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
# 以下皆為公開資料，無需金鑰（水保署警戒／圖資、水利署水庫、戶政司人口、台電計畫停電）
# ARDSWC_ALERT_URL=https://ls.ardswc.gov.tw/api/LandSlideAlertOpenData
# OFFICIAL_FILE_CACHE_DAYS=7
