{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidflow.example/schemas/public-case.schema.json",
  "title": "PublicCase",
  "description": "A case as exposed on the public portal: coarse coordinates, masked location, no PII, no EMIC case number. Flow: pending_review → reported_emic → emic_processing → closed, or pending_review → community_open → community_submitted → closed, or → dismissed.",
  "type": "object",
  "required": ["id", "case_number", "title", "category", "severity", "status", "phase", "lat", "lon", "report_count", "unique_reporter_count", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "case_number": { "type": "string" },
    "title": { "type": "string" },
    "category": { "type": "string" },
    "category_label": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "status": { "type": "string", "enum": ["pending_review", "reported_emic", "emic_processing", "community_open", "community_submitted", "closed", "dismissed"] },
    "status_label": { "type": "string" },
    "phase": { "type": "string", "enum": ["pending", "active", "community", "done", "dismissed"] },
    "track": { "type": ["string", "null"], "enum": ["emic", "community", null] },
    "track_label": { "type": ["string", "null"] },
    "lat": { "type": "number" },
    "lon": { "type": "number" },
    "town": { "type": ["string", "null"] },
    "location_label": { "type": ["string", "null"] },
    "report_count": { "type": "integer", "minimum": 0 },
    "unique_reporter_count": { "type": "integer", "minimum": 0 },
    "assigned_unit": { "type": ["string", "null"], "description": "處理單位 as recorded in EMIC" },
    "emic_status": { "type": ["string", "null"], "description": "EMIC 處理狀態文字" },
    "public_summary": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "reviewed_at": { "type": ["string", "null"] },
    "closed_at": { "type": ["string", "null"] }
  },
  "not": { "anyOf": [{ "required": ["reporter_name"] }, { "required": ["reporter_contact"] }, { "required": ["reporter_email"] }, { "required": ["address"] }, { "required": ["emic_case_no"] }] },
  "additionalProperties": false
}
